---
// Overrides Starlight's default PageTitle to:
// - size every page's title down to h3 with no top margin site-wide
//   (paired with capnatix.css's own .content-panel:has(h1) rule, which
//   tightens the vertical space around it the same way, on every page)
// - skip the visible title entirely on /api: Redoc's own spec renders
//   "Capnatix External API" as its own heading right below, so a second,
//   redundant "API Docs" heading above it added nothing. An sr-only h1
//   is kept so the page still has the one visible-or-not top-level
//   heading assistive tech expects. The version picker that used to sit
//   next to this title now lives in the top nav instead (Header.astro,
//   same /api-only visibility).
//
// PAGE_TITLE_ID isn't part of the package's public export map (only
// '@astrojs/starlight/components/*' and a handful of others are) -- '_top'
// is copied verbatim from its source (constants.ts) rather than imported.
const PAGE_TITLE_ID = '_top';

const isApiPage = Astro.url.pathname.replace(/\/+$/, '') === '/api';
---

<h1 id={PAGE_TITLE_ID} class:list={{ 'sr-only': isApiPage }}>
	{Astro.locals.starlightRoute.entry.data.title}
</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 0;
			font-size: var(--sl-text-h3);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
	/* .sr-only itself isn't defined here -- Starlight's own util.css
	   already ships the identical rule, loaded globally on every page
	   (Page.astro), so class:list={{ 'sr-only': isApiPage }} above just
	   reuses it rather than duplicating a copy that could quietly drift
	   from Starlight's own version. */
</style>
