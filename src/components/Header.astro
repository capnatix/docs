---
// Overrides Starlight's default Header to add:
// - a top-nav Docs/API tab switcher, right after the site title
// - the API Docs version picker, right before the theme toggle, visible
//   only on /api -- moved here from src/components/PageTitle.astro
//   (which used to render it next to the page's own h1, now removed
//   there in favor of the visible "Capnatix External API" heading
//   Redoc's own spec already renders directly below it)
// Everything else here is copied verbatim from @astrojs/starlight/
// components/Header.astro so the rest of the header keeps behaving
// exactly like stock Starlight.
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const isApiPage = Astro.url.pathname.replace(/\/+$/, '') === '/api';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="tab-switcher" aria-label="Section">
		<a href="/" aria-current={isApiPage ? undefined : 'page'}>Docs</a>
		<a href="/api/" aria-current={isApiPage ? 'page' : undefined}>API</a>
	</nav>
	<div class="sl-flex search-wrapper print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		{
			isApiPage && (
				<label class="api-docs-version">
					<span>Version</span>
					<select id="api-explorer-version" />
				</label>
			)
		}
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		/* Compact by default -- below 50rem (where the site title's own
		   overflow:clip/min-width:0 is the header's only other flexible
		   element) this used fixed desktop-sized padding, squeezing the
		   logo/title harder than the single link it replaced ever did (that
		   link was hidden below the same breakpoint; this is core
		   navigation now, so hiding it isn't the right trade either).
		   Widens to the original sizing at the same 50rem breakpoint the
		   rest of this header already switches to a desktop layout at. */
		.tab-switcher {
			display: flex;
			gap: 0.2rem;
			padding: 0.15rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 999px;
			flex-shrink: 0;
		}
		.tab-switcher a {
			padding: 0.25rem 0.6rem;
			border-radius: 999px;
			font-size: var(--sl-text-xs);
			font-weight: 600;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			white-space: nowrap;
		}
		.tab-switcher a:hover {
			color: var(--sl-color-white);
		}
		.tab-switcher a[aria-current='page'] {
			background: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		.api-docs-version {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: var(--sl-text-xs);
			font-weight: 600;
			color: var(--sl-color-gray-2);
			white-space: nowrap;
		}
		.api-docs-version select {
			appearance: none;
			box-sizing: border-box;
			height: 2.25rem;
			line-height: 2.25rem;
			font: inherit;
			font-weight: 400;
			font-size: var(--sl-text-sm);
			padding: 0 1.75rem 0 0.6rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.25rem;
			background-color: var(--sl-color-bg);
			color: var(--sl-color-text);
			min-width: 9rem;
			background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
				linear-gradient(135deg, currentColor 50%, transparent 50%);
			background-position:
				calc(100% - 1.1rem) center,
				calc(100% - 0.75rem) center;
			background-size:
				0.35rem 0.35rem,
				0.35rem 0.35rem;
			background-repeat: no-repeat;
		}

		@media (min-width: 50rem) {
			.tab-switcher {
				gap: 0.25rem;
				padding: 0.2rem;
			}
			.tab-switcher a {
				padding: 0.3rem 0.9rem;
				font-size: var(--sl-text-sm);
			}

			/* Stock Starlight aligns the search box's column width to
			   --sl-content-width via the calc() grid this replaced, so the
			   header visually lines up with the sidebar/content boundary
			   below it. That variable now varies hugely page to page --
			   Docs pages keep Starlight's sidebar-width default, the API
			   page widens it to fill the page with no sidebar at all (see
			   api.astro) -- which made the whole header visibly reflow
			   between the two on every Docs/API switch. A plain flex row
			   doesn't depend on --sl-content-width at all, so it can't. */
			.search-wrapper {
				flex: 1;
				max-width: 30rem;
			}
		}
	}
</style>
