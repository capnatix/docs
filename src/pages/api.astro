---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---
<StarlightPage
	frontmatter={{
		title: 'API Docs',
		description: 'Reference for the Capnatix external API — pick a released version to browse its contract.',
		tableOfContents: false,
	}}
>
	<p id="api-explorer-status" role="status" aria-live="polite" class="status-region"></p>

	{/* Redoc renders inside its own document here, not directly on this
	   page -- see api-docs.js's own header comment for why (in short:
	   Redoc expects to fully own its page's window/scroll, which sharing
	   this one with Starlight's own fixed header and layout couldn't
	   reliably give it). */}
	<iframe id="redoc-frame" title="API Docs"></iframe>

	<script is:inline defer data-astro-rerun src="/assets/api-docs.js"></script>
</StarlightPage>

<style>
	.status-region {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		min-height: 1.1em;
	}
	.status-region:empty {
		display: none;
	}
</style>

<style is:global>
	/* Starlight's default content column (--sl-content-width: 45rem) is sized
	   for prose, not for Redoc's three-panel layout -- widen it on this page
	   only. This file's own is:global styles only ever ship on /api (this
	   page's own output), so there's no cross-page leak to guard against
	   despite the global flag. */
	:root {
		--sl-content-width: 90rem;
	}

	/* Scoped (astro-hash-suffixed) selectors for this element were
	   inexplicably not taking effect -- computed style kept resolving to
	   the browser's bare default iframe size (300x150) despite the rule
	   being present in the built output and matching the element. Global,
	   unscoped, this applies reliably. */
	#redoc-frame {
		display: block;
		width: 100%;
		height: calc(100vh - var(--sl-nav-height, 3.5rem) - 5rem);
		min-height: 48rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
</style>
