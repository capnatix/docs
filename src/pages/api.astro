---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---
<StarlightPage
	frontmatter={{
		title: 'API Docs',
		description: 'Reference for the Capnatix external API — pick a released version to browse its contract.',
		tableOfContents: false,
	}}
	hasSidebar={false}
>
	<p id="api-explorer-status" role="status" aria-live="polite" class="status-region"></p>

	{/* Redoc renders inside its own document here, not directly on this
	   page -- see api-docs.js's own header comment for why (in short:
	   Redoc expects to fully own its page's window/scroll, which sharing
	   this one with Starlight's own fixed header and layout couldn't
	   reliably give it). */}
	<iframe id="redoc-frame" title="API Docs"></iframe>

	<script is:inline defer data-astro-rerun src="/assets/api-docs.js"></script>
</StarlightPage>

<style>
	.status-region {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		min-height: 1.1em;
	}
	.status-region:empty {
		display: none;
	}

	#redoc-frame {
		display: block;
		width: 100%;
		/* Starlight's markdown.css draws vertical rhythm between any two
		   adjacent non-inline elements (.sl-markdown-content :not(...) +
		   :not(...) { margin-top: var(--sl-content-gap-y) }) -- it matched
		   the (collapsed but still DOM-present) status paragraph before
		   this iframe, adding back exactly the top gap the rest of this
		   file's CSS was zeroing out everywhere else. */
		margin-top: 0;
		/* api-docs.js's sizeFrame() sets the real height (exactly the
		   space actually remaining below this point in the viewport) the
		   moment it runs -- a static calc() guess at how much chrome sits
		   above the iframe was sometimes short, growing the OUTER page
		   past 100vh and giving it a second, redundant scrollbar next to
		   the iframe's own. This is only the pre-JS fallback. */
		height: 40rem;
		border: none;
	}
</style>

<style is:global>
	/* Starlight's own page footer (edit-this-page / prev-next links) rendered
	   below the iframe, adding height sizeFrame() never accounted for (it
	   only measures the iframe's own top down to the viewport's bottom) --
	   just enough extra to push the page past 100vh and add a redundant
	   outer scrollbar next to the iframe's own. Doesn't apply to an iframe
	   embed anyway, so hidden here rather than measured around. */
	.content-panel footer {
		display: none;
	}

	/* The title's own ContentPanel (Page.astro renders one just for
	   PageTitle, separate from the one holding this page's own slotted
	   content below) still took up space from its own padding even with
	   the h1 inside it reduced to sr-only (position: absolute, so it
	   contributes no height itself -- the PANEL's padding is what
	   remained). Zeroed instead of display: none -- that would take the
	   sr-only h1 out of the accessibility tree entirely (sr-only relies on
	   staying in the tree, just visually clipped) and break the site's
	   Skip-to-content link, whose target is this same h1's id="_top". With
	   the panel's own padding at 0 and its only child position: absolute
	   (out of normal flow), the panel still collapses to zero visual
	   height on its own -- no display: none needed to get there. */
	.content-panel:has(h1) {
		padding: 0;
	}

	/* ContentPanel's own padding and sl-container's max-width/auto
	   margin-inline centering are what otherwise left visible space
	   around the toolbar/iframe on every side -- zeroed on this page only
	   so the iframe genuinely reaches every edge instead of sitting
	   inside them. border-top: none because `.content-panel + .content-
	   panel { border-top: ... }` (a divider Starlight draws between the
	   title panel and this one) still matched -- a CSS sibling combinator
	   counts a display: none element as a sibling too, it isn't removed
	   from the DOM, just not painted.

	   max-width: none is the ONLY thing capping this column's width --
	   an earlier attempt also pinned --sl-content-width to a large value
	   on this page, on the theory that was the live constraint; it never
	   was. hasSidebar={false} above makes Starlight apply its own
	   `html:not([data-has-sidebar]) { --sl-content-width: 67.5rem }`,
	   which wins over any page-level override of that same variable
	   (confirmed via computed styles, not assumed) -- max-width: none
	   here bypasses the variable entirely rather than trying to out-value
	   it. */
	.content-panel:not(:has(h1)) {
		padding: 0;
		border-top: none;
	}
	.content-panel:not(:has(h1)) .sl-container {
		max-width: none;
		margin-inline: 0;
	}

	/* Belt-and-suspenders on top of sizeFrame()'s own precise measurement
	   (public/assets/api-docs.js): the page itself should never scroll on
	   this route, only the iframe's own content -- any leftover sub-pixel
	   rounding that could still add an outer scrollbar is clipped instead. */
	html {
		overflow: hidden;
	}
</style>
