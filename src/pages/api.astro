---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---
<StarlightPage
	frontmatter={{
		title: 'API Docs',
		description: 'Reference for the Capnatix external API — pick a released version to browse its contract.',
		tableOfContents: false,
	}}
>
	<p id="api-explorer-status" role="status" aria-live="polite" class="status-region"></p>

	<div id="redoc-container"></div>

	{/* data-astro-rerun: Starlight's client-side routing may soft-navigate
	   back to this page without a full reload, and a plain is:inline script
	   isn't guaranteed to re-execute then -- this forces it to, so the
	   dropdown/Redoc reliably come back to life every visit. */}
	<script is:inline defer data-astro-rerun src="/vendor/redoc/redoc.standalone.js"></script>
	<script is:inline defer data-astro-rerun src="/assets/api-docs.js"></script>
</StarlightPage>

<style>
	.status-region {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		min-height: 1.1em;
	}
	.status-region:empty {
		display: none;
	}

</style>

<style is:global>
	/* Starlight's default content column (--sl-content-width: 45rem) is sized
	   for prose, not for Redoc's three-panel layout -- widen it on this page
	   only. This file's own is:global styles only ever ship on /api (this
	   page's own output), so there's no cross-page leak to guard against
	   despite the global flag. */
	:root {
		--sl-content-width: 90rem;
	}

	/* Redoc's field-group labels ("Authorizations:", "Request Body
	   schema:", "Response Schema:", ...) use a hardcoded near-black color
	   (rgba(38, 50, 56, 0.7)) baked into their styled-component, not
	   derived from the theme object passed to Redoc.init -- so it can't be
	   fixed by DARK_THEME in api-docs.js, and goes near-invisible against
	   our dark background. Overridden directly, dark mode only (fine as-is
	   against a light background). */
	:root:not([data-theme='light']) #redoc-container h5 {
		color: rgba(228, 230, 230, 0.85);
	}
</style>
