---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---
<StarlightPage
	frontmatter={{
		title: 'API Docs',
		description: 'Reference for the Capnatix external API — pick a released version to browse its contract.',
		tableOfContents: false,
	}}
>
	<p id="api-explorer-status" role="status" aria-live="polite" class="status-region"></p>

	<div id="redoc-container"></div>

	{/* data-astro-rerun: Starlight's client-side routing may soft-navigate
	   back to this page without a full reload, and a plain is:inline script
	   isn't guaranteed to re-execute then -- this forces it to, so the
	   dropdown/Redoc reliably come back to life every visit. */}
	<script is:inline defer data-astro-rerun src="/vendor/redoc/redoc.standalone.js"></script>
	<script is:inline defer data-astro-rerun src="/assets/api-docs.js"></script>
</StarlightPage>

<style>
	.status-region {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		min-height: 1.1em;
	}
	.status-region:empty {
		display: none;
	}

	/* Redoc expects to own the scroll container its sidebar/scroll-spy
	   measure against. Left in normal document flow, it ends up tracking
	   the OUTER page's scroll instead of its own -- its click-to-expand
	   sidebar items then only visually catch up once a scroll event fires
	   on the right element, instead of immediately on click. Bounding it to
	   its own fixed, independently-scrolling box (the standard Redoc
	   integration pattern) gives it a scroll container that's unambiguously
	   its own. */
	#redoc-container {
		height: calc(100vh - var(--sl-nav-height, 3.5rem) - 8rem);
		min-height: 32rem;
		/* auto, not hidden: Redoc's sidebar/right-panel use position: sticky
		   internally, which sticks to the nearest ancestor whose overflow
		   isn't visible -- auto makes THIS div that ancestor (and its own
		   scroll container), instead of the sticky panels attaching to the
		   page/window's scroll the way overflow: hidden left them doing. */
		overflow-y: auto;
		overflow-x: hidden;
	}
</style>

<style is:global>
	/* Starlight's default content column (--sl-content-width: 45rem) is sized
	   for prose, not for Redoc's three-panel layout -- widen it on this page
	   only. This file's own is:global styles only ever ship on /api (this
	   page's own output), so there's no cross-page leak to guard against
	   despite the global flag. */
	:root {
		--sl-content-width: 90rem;
	}
</style>
